{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/ui/oxlint/recommended.json"],
  "plugins": ["eslint", "typescript", "oxc"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.zgui-generations/**",
    "target/**",
    "vendor/**",
    "packages/ui/src/components/generated/**",
    "tests/build/.fixture-*/**",
    "tests/build/.image-*/**",
    "tests/build/.dependency-*/**"
  ],
  "rules": {
    "no-warning-comments": ["error", { "terms": ["todo", "fixme", "xxx"], "location": "anywhere" }],
    "zgui/no-essay-comments": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/ui/src/host.ts",
        "packages/ui/src/nodes.ts",
        "packages/ui/src/portal.ts",
        "packages/ui/src/render-app.ts",
        "packages/ui/src/button.ts",
        "packages/ui/src/renderer/**",
        "packages/ui/src/components/shared.ts",
        "packages/ui/src/runtime-globals.ts",
        "packages/services/src/index.ts"
      ],
      "rules": {
        "zgui/no-direct-bridge": "off",
        "zgui/no-raw-insert-or-provider": "off",
        "no-restricted-globals": "off",
        "no-shadow-restricted-names": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": [
        "packages/ui/src/components/delay.ts",
        "packages/ui/src/components/overlay.ts",
        "packages/ui/src/spring.ts",
        "packages/ui/src/timers.ts"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["apps/examples/async/**"],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["packages/build/**", "tools/**", "packages/ui/oxlint/**"],
      "rules": {
        "zgui/no-direct-bridge": "off",
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["tools/**", "packages/ui/oxlint/**"],
      "rules": {
        "typescript/require-array-sort-compare": "off"
      }
    },
    {
      "files": ["tests/fixtures/**"],
      "rules": {
        "zgui/no-solid-web-imports": "off"
      }
    },
    {
      "files": ["tests/build/**", "tests/preview/*.mjs", "tests/native-controls/**"],
      "rules": {
        "zgui/no-direct-bridge": "off",
        "zgui/no-raw-insert-or-provider": "off",
        "zgui/no-internal-package-imports": "off",
        "no-restricted-globals": "off",
        "typescript/no-base-to-string": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["tests/types/**"],
      "rules": {
        "zgui/no-direct-bridge": "off",
        "zgui/no-raw-insert-or-provider": "off",
        "zgui/no-internal-package-imports": "off",
        "zgui/no-top-level-service-call": "off",
        "no-restricted-globals": "off",
        "no-unused-vars": "off",
        "no-unassigned-vars": "off"
      }
    }
  ]
}
