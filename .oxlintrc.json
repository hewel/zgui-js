{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/ui/oxlint/recommended.json"],
  "plugins": ["eslint", "typescript", "oxc"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.zgui-generations/**",
    "target/**",
    "vendor/**",
    "packages/ui/src/components/generated/**",
    "tests/build/.fixture-*/**",
    "tests/build/.dev-mode-*/**",
    "tests/build/.image-*/**",
    "tests/build/.dependency-*/**"
  ],
  "rules": {
    "no-warning-comments": ["error", { "terms": ["todo", "fixme", "xxx"], "location": "anywhere" }],
    "zgui/no-essay-comments": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/ui/src/host.ts",
        "packages/ui/src/nodes.ts",
        "packages/ui/src/portal.ts",
        "packages/ui/src/render-app.ts",
        "packages/ui/src/button.ts",
        "packages/ui/src/renderer/**",
        "packages/ui/src/components/shared.ts",
        "packages/ui/src/runtime-globals.ts",
        "packages/services/src/index.ts"
      ],
      "rules": {
        "zgui/no-direct-bridge": "off",
        "zgui/no-raw-insert-or-provider": "off",
        "no-restricted-globals": "off",
        "no-shadow-restricted-names": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": [
        "packages/ui/src/components/delay.ts",
        "packages/ui/src/components/overlay.ts",
        "packages/ui/src/primitives/delay.ts",
        "packages/ui/src/primitives/overlay.ts",
        "packages/ui/src/spring.ts",
        "packages/ui/src/timers.ts",
        "packages/services/src/kv-state.ts"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["apps/examples/async/**"],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": [
        "packages/build/**",
        "packages/cli/**",
        "packages/create-zgui-js/**",
        "packages/host-*/**",
        "tools/**",
        "packages/ui/oxlint/**"
      ],
      "rules": {
        "zgui/no-direct-bridge": "off",
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["tools/**", "packages/ui/oxlint/**"],
      "rules": {
        "typescript/require-array-sort-compare": "off"
      }
    },
    {
      "files": ["packages/ui/src/solid-native.d.ts", "packages/ui/src/renderer/**"],
      "rules": {
        "zgui/no-solid-web-imports": "off"
      }
    },
    {
      "files": [
        "packages/ui/src/host.ts",
        "packages/ui/src/portal.ts",
        "packages/ui/src/shell.ts",
        "packages/ui/src/spring.ts",
        "packages/ui/src/virtual-list.ts",
        "packages/ui/src/router/components.ts",
        "packages/ui/src/primitives/menu.ts",
        "packages/ui/src/primitives/radio.ts",
        "packages/ui/src/components/accordion.ts",
        "packages/ui/src/components/collapsible.ts",
        "packages/ui/src/components/groups.ts",
        "packages/ui/src/components/icons.ts",
        "packages/ui/src/components/menubar.ts",
        "packages/ui/src/components/popper.ts",
        "packages/ui/src/components/select.ts",
        "packages/ui/src/components/tabs.ts",
        "packages/ui/src/components/theme.ts",
        "packages/ui/src/components/toast.ts",
        "packages/ui/src/components/tree-view.ts"
      ],
      "rules": {
        "solid/reactivity": "off"
      }
    },
    {
      "files": ["tests/fixtures/**"],
      "rules": {
        "zgui/no-solid-web-imports": "off"
      }
    },
    {
      "files": ["tests/preview/fixtures/**"],
      "rules": {
        "zgui/no-static-component-stylesheet": "off"
      }
    },
    {
      "files": ["tests/build/**", "tests/preview/*.mjs", "tests/native-controls/**"],
      "rules": {
        "zgui/no-direct-bridge": "off",
        "zgui/no-raw-insert-or-provider": "off",
        "zgui/no-internal-package-imports": "off",
        "no-restricted-globals": "off",
        "typescript/no-base-to-string": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["tests/types/**"],
      "rules": {
        "zgui/no-direct-bridge": "off",
        "zgui/no-raw-insert-or-provider": "off",
        "zgui/no-internal-package-imports": "off",
        "zgui/no-top-level-service-call": "off",
        "no-restricted-globals": "off",
        "no-unused-vars": "off",
        "no-unassigned-vars": "off",
        "solid/no-unassigned-vars": "off",
        "solid/no-unused-signal": "off",
        "solid/reactivity": "off",
        "solid/event-handlers": "off"
      }
    },
    {
      "files": [
        "packages/ui/src/**",
        "packages/services/src/**",
        "apps/devtools/**",
        "apps/examples/components/**",
        "apps/examples/composition/**",
        "apps/examples/controls/**",
        "apps/examples/css-modules/**",
        "apps/examples/editing/**",
        "apps/examples/gallery/**",
        "apps/examples/lists/**",
        "apps/examples/selection/**",
        "apps/examples/tabs/**"
      ],
      "rules": {
        "zgui/prefer-stylesheet": "error"
      }
    }
  ]
}
