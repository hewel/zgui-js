{
  "name": "@hewel/zgui-js-example-sysmon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "zgui-js dev",
    "build": "zgui-js build",
    "preview": "zgui-js preview"
  },
  "zgui": {
    "window": {
      "title": "zgui System Monitor",
      "width": 1160,
      "height": 760,
      "minWidth": 820,
      "minHeight": 560
    },
    "capabilities": {
      "commands": [
        "/usr/bin/vmstat",
        "/usr/bin/ps",
        "/usr/bin/free",
        "/usr/bin/df",
        "/usr/bin/uname"
      ],
      "controlChannel": true
    }
  },
  "devDependencies": {
    "@hewel/zgui-build": "workspace:*"
  },
  "dependencies": {
    "@hewel/zgui": "workspace:*",
    "@hewel/zgui-services": "workspace:*"
  }
}
