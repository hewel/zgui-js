{
  "schemaVersion": 1,
  "id": "scripted-services",
  "services": {
    "assets": {
      "provider": "mock-text-assets-v1",
      "latencyMs": 20,
      "initialState": { "assets": { "assets/message.txt": {} } }
    }
  },
  "events": [
    {
      "atMs": 100,
      "channel": "assets.state",
      "value": {
        "assets": {
          "assets/message.txt": {
            "error": { "code": "Io", "message": "scripted text service failure" }
          }
        }
      }
    }
  ]
}
