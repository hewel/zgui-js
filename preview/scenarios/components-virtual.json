{
  "schemaVersion": 1,
  "id": "components-virtual",
  "requiredCapabilities": [
    "pixels",
    "virtual-time",
    "selectors.test-id",
    "input.pointer",
    "tree.inspect"
  ],
  "steps": [
    {
      "id": "initial",
      "op": "capture",
      "captureId": "initial",
      "requiredFrameTimeUs": 0
    },
    {
      "id": "click",
      "op": "pointer.click",
      "target": {
        "surface": "main",
        "testId": "increment"
      },
      "button": "primary"
    },
    {
      "id": "advance",
      "op": "clock.advance",
      "byMs": 20
    },
    {
      "id": "verify",
      "op": "assert",
      "target": {
        "surface": "main",
        "testId": "count"
      },
      "check": {
        "property": "text",
        "equals": "Count: 1"
      }
    },
    {
      "id": "toggle",
      "op": "pointer.click",
      "target": {
        "surface": "main",
        "testId": "theme-toggle"
      },
      "button": "primary"
    },
    {
      "id": "advance-scheme",
      "op": "clock.advance",
      "byMs": 300
    },
    {
      "id": "verify-scheme",
      "op": "assert",
      "target": {
        "surface": "main",
        "testId": "scheme"
      },
      "check": {
        "property": "text",
        "equals": "dark"
      }
    },
    {
      "id": "final",
      "op": "capture",
      "captureId": "after-theme",
      "requiredFrameTimeUs": 320000
    }
  ]
}