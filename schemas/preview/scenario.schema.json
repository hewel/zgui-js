{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zgui-js.local/schemas/preview/scenario.schema.json",
  "title": "Preview scenario v1 (native interaction and deterministic time)",
  "description": "Closed input, at most 1 MiB. Implements native main-surface input/assertions, bounded settle/capture, explicit virtual clock.advance, typed fixture service.emit/call assertions and resize/scale/recreate. Step IDs and capture IDs are unique in their namespaces. Capability declarations are unioned with inferred requirements. Virtual profiles, clock.advance and requiredFrameTimeUs require virtual-time; wall profiles reject virtual-time. Known future operations fail with E_UNSUPPORTED_CAPABILITY; malformed supported payloads fail with E_SCHEMA before application mount.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "requiredCapabilities", "steps"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "requiredCapabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/safeId" },
      "description": "Capabilities must be available before mount. Repeated declarations are deduplicated; omission never bypasses inferred requirements."
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/settle" },
          { "$ref": "#/$defs/capture" },
          { "$ref": "#/$defs/pointerMove" },
          { "$ref": "#/$defs/pointerClick" },
          { "$ref": "#/$defs/keyPress" },
          { "$ref": "#/$defs/textCommit" },
          { "$ref": "#/$defs/assert" },
          { "$ref": "#/$defs/assertService" },
          { "$ref": "#/$defs/clockAdvance" },
          { "$ref": "#/$defs/serviceEmit" },
          { "$ref": "#/$defs/surfaceResize" },
          { "$ref": "#/$defs/surfaceScale" },
          { "$ref": "#/$defs/surfaceRecreate" }
        ]
      }
    }
  },
  "$defs": {
    "safeId": {
      "description": "One safe path component matching [a-z0-9][a-z0-9._-]*; no separators, traversal components, whitespace or encoding escapes. The absolute end assertion also rejects a trailing newline.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
    },
    "settle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "settle" },
        "timeoutMs": {
          "description": "Optional lower real per-step budget, in milliseconds. If present it must be a positive JSON integer literal, not null. The driver rejects values above profile.limits.maxStepWallMs; this option cannot raise a profile limit or add a sleep.",
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "captureId"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "capture" },
        "captureId": { "$ref": "#/$defs/safeId" },
        "allowedPendingAssets": {
          "description": "Exact current visible pending native image request IDs. Infers assets.native-readiness. Stale, canceled, failed, duplicate and unknown IDs fail; this never permits a resource failure.",
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeId" }
        },
        "requiredFrameTimeUs": {
          "description": "Optional exact virtual validation-frame timestamp. A present value must be a nonnegative JSON integer literal, not null. Infers virtual-time and is unavailable in wall-clock profiles; it must never be silently ignored.",
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "surface": {
      "type": "string",
      "const": "main",
      "description": "Other logical surfaces fail preflight with E_UNSUPPORTED_CAPABILITY."
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "testId"],
          "properties": {
            "surface": { "$ref": "#/$defs/surface" },
            "testId": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "role", "name"],
          "properties": {
            "surface": { "$ref": "#/$defs/surface" },
            "role": { "type": "string" },
            "name": { "type": "string" }
          }
        }
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308 },
        "y": { "type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308 }
      },
      "description": "Finite logical surface coordinates; position is not a selector."
    },
    "pointerLocation": {
      "oneOf": [
        {
          "required": ["target"],
          "not": { "anyOf": [{ "required": ["surface"] }, { "required": ["position"] }] }
        },
        {
          "required": ["surface", "position"],
          "not": { "required": ["target"] }
        }
      ]
    },
    "pointerMove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op"],
      "allOf": [{ "$ref": "#/$defs/pointerLocation" }],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "pointer.move" },
        "target": { "$ref": "#/$defs/target" },
        "surface": { "$ref": "#/$defs/surface" },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "pointerClick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "button"],
      "allOf": [{ "$ref": "#/$defs/pointerLocation" }],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "pointer.click" },
        "target": { "$ref": "#/$defs/target" },
        "surface": { "$ref": "#/$defs/surface" },
        "position": { "$ref": "#/$defs/position" },
        "button": { "type": "string", "enum": ["primary", "secondary", "middle"] }
      }
    },
    "keyPress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "surface", "key"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "key.press" },
        "surface": { "$ref": "#/$defs/surface" },
        "key": {
          "type": "string",
          "enum": ["Tab", "Enter", "Escape", "Space", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End", "Backspace", "Delete"]
        },
        "modifiers": {
          "type": "array",
          "default": [],
          "items": { "type": "string", "enum": ["Shift", "Control", "Alt", "Meta"] }
        }
      }
    },
    "textCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "surface", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "text.commit" },
        "surface": { "$ref": "#/$defs/surface" },
        "text": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "equals"],
      "properties": {
        "property": {
          "type": "string",
          "enum": ["exists", "text", "role", "name", "enabled", "focused", "visible", "value"]
        },
        "equals": { "type": ["boolean", "string"] }
      },
      "oneOf": [
        {
          "properties": {
            "property": { "enum": ["exists", "enabled", "focused", "visible"] },
            "equals": { "type": "boolean" }
          }
        },
        {
          "properties": {
            "property": { "enum": ["text", "role", "name", "value"] },
            "equals": { "type": "string" }
          }
        }
      ]
    },
    "assert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "target", "check"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "assert" },
        "target": { "$ref": "#/$defs/target" },
        "check": { "$ref": "#/$defs/check" }
      }
    },
    "assertService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "serviceCall"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "assert" },
        "serviceCall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "method", "count"],
          "properties": {
            "service": { "$ref": "#/$defs/safeId" },
            "method": { "type": "string", "minLength": 1, "maxLength": 128 },
            "count": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
            "errorCode": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "clockAdvance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "byMs"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "clock.advance" },
        "byMs": {
          "description": "Nonnegative JSON integer literal. Cumulative advances must not exceed profile.limits.maxVirtualDurationMs. Visits native and fixture deadlines, then the exact endpoint; zero drains current work without moving time.",
          "type": "integer", "minimum": 0, "maximum": 18446744073709551615
        }
      }
    },
    "serviceEmit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "channel", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "service.emit" },
        "channel": { "$ref": "#/$defs/safeId" },
        "value": {
          "description": "Closed provider-specific payload, validated against the configured fixture channel. Never invokes a live service.",
          "type": "object"
        }
      }
    },
    "surfaceResize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "surface", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "surface.resize" },
        "surface": { "$ref": "#/$defs/surface" },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      },
      "description": "Logical dimensions. The resulting physical extent must satisfy profile bounds at the current scale. Delivers a native resize without moving virtual time."
    },
    "surfaceScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "surface", "scale"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "surface.scale" },
        "surface": { "$ref": "#/$defs/surface" },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 }
      },
      "description": "Delivers one native scale/physical-size event without moving virtual time; current resource demand must become ready at the new scale."
    },
    "surfaceRecreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "surface"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "op": { "const": "surface.recreate" },
        "surface": { "$ref": "#/$defs/surface" }
      },
      "description": "Suspends and resumes the real native main document, disposing its session and creating a fresh generation. Clock, RNG and fixture scenario history continue; retired registrations and capture/accessibility mappings are canceled."
    }
  }
}
