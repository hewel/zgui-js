{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zgui-js.local/schemas/package.schema.json",
  "title": "Native package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "hostApiVersion",
    "entry",
    "sourceMap",
    "styles",
    "assets",
    "fonts",
    "styleSystem",
    "artifactDigests",
    "buildId"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "hostApiVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
    },
    "entry": { "$ref": "#/$defs/path" },
    "sourceMap": { "$ref": "#/$defs/path" },
    "bytecodeFormat": { "const": "qjs-bytecode-v1" },
    "quickjsAbi": { "type": "string", "minLength": 1 },
    "chunks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sourceMap"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sourceMap": { "$ref": "#/$defs/path" }
        }
      }
    },
    "workers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "sourceMap"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}(?![\\s\\S])$" },
          "path": { "$ref": "#/$defs/path" },
          "sourceMap": { "$ref": "#/$defs/path" }
        }
      }
    },
    "styles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "fonts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "path"],
        "properties": {
          "family": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
          "path": { "$ref": "#/$defs/path" }
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "minWidth": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "minHeight": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "resizable": { "type": "boolean" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "description": "Omitted flags and lists grant no authority. Only non-default declarations are included in the build identity.",
      "properties": {
        "shellSurfaces": { "type": "boolean", "default": false },
        "sessionLock": { "type": "boolean", "default": false },
        "imagePrefixes": { "$ref": "#/$defs/hostPaths", "default": [] },
        "unixSockets": { "$ref": "#/$defs/hostPaths", "default": [] },
        "namedSockets": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": { "$ref": "#/$defs/socketName" }
        },
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": { "type": "string", "pattern": "^(?=.*[^ ])[^\\u0000-\\u001f\\u007f-\\u009f]+$" }
        },
        "controlChannel": { "type": "boolean", "default": false },
        "singleInstance": { "type": "boolean", "default": false },
        "clipboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "boolean", "default": false }
          }
        },
        "sqlite": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "databases": {
              "type": "array",
              "uniqueItems": true,
              "default": [],
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "directories": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "mode"],
                "properties": {
                  "path": { "$ref": "#/$defs/fileDirectoryPath" },
                  "mode": { "enum": ["read", "readwrite"] }
                }
              }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origins": {
              "type": "array",
              "uniqueItems": true,
              "default": [],
              "items": { "$ref": "#/$defs/networkOrigin" }
            },
            "originRules": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["origin"],
                "properties": {
                  "origin": { "$ref": "#/$defs/networkOrigin" },
                  "allowInsecureHttp": { "type": "boolean", "default": false },
                  "allowPrivateNetworks": { "type": "boolean", "default": false }
                }
              }
            },
            "allowInsecureHttp": { "type": "boolean", "default": false },
            "allowPrivateNetworks": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "styleSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile", "configDigest"],
      "properties": {
        "name": { "const": "lightningcss" },
        "profile": { "const": "lightningcss-v1" },
        "configDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifactDigests": {
      "type": "object",
      "required": ["build-info.json"],
      "propertyNames": { "$ref": "#/$defs/path" },
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "buildId": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\\\u0000])(?!(?:.*\/)?\\.{1,2}(?:\/|$))[^/]+(?:/[^/]+)*$"
    },
    "socketName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}(?![\\s\\S])" },
    "literalHostPath": {
      "type": "string",
      "pattern": "^/(?:$|(?:(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f-\\u009f]+/)*(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f-\\u009f]+$)"
    },
    "hostPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "anyOf": [
          { "$ref": "#/$defs/literalHostPath" },
          {
            "pattern": "^\\$(?:XDG_RUNTIME_DIR|HOME|XDG_DATA_HOME)(?:/(?!\\.{1,2}(?:/|$))(?:\\$WAYLAND_DISPLAY(?=/|$)|(?:[^$/\\\\\\u0000-\\u001f\\u007f-\\u009f]|\\$\\{WAYLAND_DISPLAY\\})+))*(?![\\s\\S])"
          }
        ]
      }
    },
    "fileDirectoryPath": {
      "type": "string",
      "anyOf": [
        { "$ref": "#/$defs/literalHostPath" },
        {
          "pattern": "^\\$(?:HOME|XDG_DATA_HOME|XDG_DOCUMENTS_DIR)(?:/(?!\\.{1,2}(?:/|$))[^$/\\\\\\u0000-\\u001f\\u007f-\\u009f]+)*(?![\\s\\S])"
        }
      ]
    },
    "networkOrigin": {
      "type": "string",
      "pattern": "^(?:https?|wss?)://[^\\s/?#*@\\\\\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
