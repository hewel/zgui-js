{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zgui-js.local/schemas/package.schema.json",
  "title": "Native package v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "hostApiVersion", "entry", "sourceMap", "styles", "assets", "fonts", "styleSystem", "artifactDigests", "buildId"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "hostApiVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
    },
    "entry": { "$ref": "#/$defs/path" },
    "sourceMap": { "$ref": "#/$defs/path" },
    "styles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "fonts": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["family", "path"],
        "properties": {
          "family": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
          "path": { "$ref": "#/$defs/path" }
        }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "description": "Omitted flags and lists grant no authority. Only non-default declarations are included in the build identity.",
      "properties": {
        "shellSurfaces": { "type": "boolean", "default": false },
        "sessionLock": { "type": "boolean", "default": false },
        "imagePrefixes": { "$ref": "#/$defs/hostPaths", "default": [] },
        "unixSockets": { "$ref": "#/$defs/hostPaths", "default": [] },
        "namedSockets": {
          "type": "array", "uniqueItems": true, "default": [],
          "items": { "$ref": "#/$defs/socketName" }
        },
        "commands": {
          "type": "array", "uniqueItems": true, "default": [],
          "items": { "type": "string", "pattern": "^(?=.*[^ ])[^\\u0000-\\u001f\\u007f-\\u009f]+$" }
        },
        "controlChannel": { "type": "boolean", "default": false }
      }
    },
    "styleSystem": {
      "type": "object", "additionalProperties": false, "required": ["name", "profile", "configDigest", "nativeProfileDigest"],
      "properties": {
        "name": { "const": "stylex" },
        "profile": { "const": "zgui-stylex-v1" },
        "configDigest": { "$ref": "#/$defs/digest" },
        "nativeProfileDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifactDigests": {
      "type": "object", "required": ["style-origins.json", "build-info.json"],
      "propertyNames": { "$ref": "#/$defs/path" },
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "buildId": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*[\\\\\\u0000])(?!(?:.*\/)?\\.{1,2}(?:\/|$))[^/]+(?:/[^/]+)*$" },
    "socketName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}(?![\\s\\S])" },
    "literalHostPath": {
      "type": "string",
      "pattern": "^/(?:$|(?:(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f-\\u009f]+/)*(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f-\\u009f]+$)"
    },
    "hostPaths": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "string",
        "anyOf": [
          { "$ref": "#/$defs/literalHostPath" },
          { "pattern": "^\\$(?:XDG_RUNTIME_DIR|HOME|XDG_DATA_HOME)(?:/(?!\\.{1,2}(?:/|$))(?:\\$WAYLAND_DISPLAY(?=/|$)|(?:[^$/\\\\\\u0000-\\u001f\\u007f-\\u009f]|\\$\\{WAYLAND_DISPLAY\\})+))*(?![\\s\\S])" }
        ]
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
