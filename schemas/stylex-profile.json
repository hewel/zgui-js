{
  "schemaVersion": 1,
  "name": "zgui-stylex-v1",
  "stylexVersion": "0.19.2",
  "styleResolution": "property-specificity",
  "useLayers": false,
  "legacyDisableLayers": false,
  "selectors": {
    "root": true,
    "idNegationPriorityChains": true,
    "doubledClass": true,
    "doubledClassRoot": true,
    "hover": true,
    "focus": true,
    "browserHtmlDirection": false
  },
  "atRules": {
    "mediaViewport": true,
    "keyframes": true,
    "dynamicPropertyUniversalNoninheriting": true,
    "typedProperty": false,
    "container": false,
    "prefersReducedMotion": false,
    "fontFace": false,
    "import": false
  },
  "resources": {
    "cssUrl": false,
    "imageSet": false,
    "packageImageElement": true,
    "manifestFontFamilies": true
  },
  "customProperties": {
    "caseSensitiveNames": true,
    "finiteNumbers": true,
    "ordinaryInheritance": true,
    "officialDynamicNoninheritance": true
  },
  "reload": "full-session",
  "cssOnlyActivation": false
}
