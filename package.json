{
  "name": "zgui-js",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/build",
    "packages/ui",
    "packages/services",
    "apps/examples/*"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "fmt": "bun --bun run oxfmt",
    "fmt:check": "bun --bun run oxfmt --check",
    "lint": "bun --bun run oxlint --deny-warnings",
    "typecheck": "bun packages/build/src/typecheck.ts",
    "typecheck:smoke": "bun --bun run tsrs --project packages/build/tsconfig.smoke.json",
    "test:build": "bun test --parallel --timeout=30000 tests/build/*.test.mjs",
    "test:rust": "cargo test -j 4 --workspace --offline && cargo clippy -j 4 --workspace --all-targets --offline -- -D warnings",
    "test:vendor": "bun tools/test-vendor.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "bun packages/build/src/cli.ts build",
    "dev": "bun packages/build/src/cli.ts dev",
    "preview": "bun packages/build/src/cli.ts preview",
    "preview:check": "bun packages/build/src/preview-check.ts",
    "test:preview": "bun run build --app counter && cargo build -j 4 -p native-host --locked --offline && bun test --isolate --timeout=30000 tests/preview/*.test.mjs",
    "smoke": "bun packages/build/src/cli.ts smoke && bun packages/build/src/check-smoke.ts",
    "check": "bun run lint && bun run typecheck && bun run test:build && bun run test:rust"
  },
  "devDependencies": {
    "@hewel/zgui": "workspace:*",
    "@hewel/zgui-services": "workspace:*",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "solid-js": "2.0.1",
    "tsrs": "7.1.0-beta.tsrs2"
  }
}
