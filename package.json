{
  "name": "zgui-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "typecheck": "node packages/build/src/typecheck.mjs",
    "typecheck:smoke": "tsc --project packages/build/tsconfig.smoke.json",
    "test:build": "node --test tests/build/*.test.mjs",
    "ui:build": "node packages/build/src/cli.mjs",
    "preview:check": "node packages/build/src/preview-check.mjs",
    "test:preview": "pnpm ui:build --app counter && cargo build -p native-host && node --test tests/preview/*.test.mjs",
    "ui:dev": "node packages/build/src/cli.mjs --watch",
    "smoke": "pnpm ui:build --smoke && node packages/build/src/check-smoke.mjs"
  },
  "devDependencies": {
    "solid-js": "1.9.19",
    "@zgui/ui": "workspace:*",
    "@zgui/services": "workspace:*",
    "typescript": "5.9.3"
  }
}
