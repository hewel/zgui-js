{
  "name": "zgui-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "typecheck": "node packages/build/src/typecheck.mjs",
    "typecheck:smoke": "tsc --project packages/build/tsconfig.smoke.json",
    "test:build": "node --test tests/build/*.test.mjs",
    "build": "node packages/build/src/cli.mjs build",
    "dev": "node packages/build/src/cli.mjs dev",
    "preview": "node packages/build/src/cli.mjs preview",
    "preview:check": "node packages/build/src/preview-check.mjs",
    "test:preview": "pnpm build --app counter && cargo build -p native-host --locked && node --test tests/preview/*.test.mjs",
    "smoke": "node packages/build/src/cli.mjs smoke && node packages/build/src/check-smoke.mjs"
  },
  "devDependencies": {
    "@zgui/services": "workspace:*",
    "@zgui/ui": "workspace:*",
    "solid-js": "1.9.19",
    "typescript": "7.0.2"
  }
}
