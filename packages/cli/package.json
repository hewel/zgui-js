{
  "name": "@hewel/zgui-cli",
  "version": "0.1.0",
  "description": "Official npm/Bun CLI for building, running, inspecting, and packaging zgui-js applications",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "inspector"
  ],
  "bin": {
    "zgui-js": "./src/cli.ts"
  },
  "scripts": {
    "prepack": "bun pack-resources.ts",
    "postpack": "bun pack-resources.ts --clean"
  },
  "dependencies": {
    "@hewel/zgui-build": "workspace:*"
  },
  "optionalDependencies": {
    "@hewel/zgui-host-linux-x64": "workspace:*",
    "@hewel/zgui-host-linux-arm64": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  }
}
