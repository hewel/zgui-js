{
  "plugins": ["eslint", "typescript", "oxc"],
  "jsPlugins": ["./plugin.mjs", "./solid.mjs"],
  "settings": {
    "solid": {
      "version": 2,
      "moduleSources": ["@hewel/zgui", "#solid"]
    }
  },
  "rules": {
    "no-debugger": "error",
    "no-unassigned-vars": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-restricted-globals": [
      "error",
      {
        "name": "setTimeout",
        "message": "Do not call raw setTimeout in components or apps; use createDelay() or createTimeout() from @hewel/zgui so timers cancel when owners dispose."
      },
      {
        "name": "setInterval",
        "message": "Do not call raw setInterval in components or apps; use createInterval() or createDelay() from @hewel/zgui instead of unguarded polling."
      },
      {
        "name": "requestAnimationFrame",
        "message": "Do not call raw requestAnimationFrame in components or apps; use createSpring() for motion."
      },
      {
        "name": "cancelAnimationFrame",
        "message": "Do not manage raw animation frame handles in components or apps; createSpring() owns its frames."
      }
    ],
    "zgui/no-direct-bridge": "error",
    "zgui/no-raw-insert-or-provider": "error",
    "zgui/no-unthemed-primitives-with-components": "error",
    "zgui/no-internal-package-imports": "error",
    "zgui/no-cleanup-in-ref": "error",
    "zgui/no-top-level-service-call": "error",
    "zgui/no-solid-web-imports": "error",
    "zgui/no-lint-suppression": "error",
    "zgui/no-getter-object-spread": "error",
    "zgui/no-static-component-stylesheet": "error",
    "solid/no-unassigned-vars": "error",
    "solid/reactivity": [
      "error",
      {
        "customReactiveFunctions": [
          "renderApp",
          "renderShell",
          "observeGeometry",
          "trapFocus",
          "lockScroll",
          "registerDismissLayer",
          "scrollTo",
          "scrollBy",
          "scrollIntoView",
          "getSelection",
          "setSelection",
          "selectAll",
          "getDocumentSelection",
          "setDocumentSelection",
          "clearDocumentSelection",
          "selectDocumentAll",
          "bindControlNavigation",
          "onControlMessage"
        ]
      }
    ],
    "solid/no-destructure": "error",
    "solid/components-return-once": "error",
    "solid/no-store-mutation-outside-setter": "error",
    "solid/no-write-in-pure-computation": "error",
    "solid/no-single-arg-create-effect": "error",
    "solid/removed-api": "error",
    "solid/no-accessor-as-prop": "error",
    "solid/event-handlers": "error",
    "solid/jsx-no-duplicate-props": "error",
    "solid/self-closing-comp": "error",
    "solid/no-unused-signal": "error",
    "solid/action-yield-after-await": "error"
  }
}
