{
  "name": "@hewel/zgui",
  "version": "0.1.3",
  "description": "Zero-DOM native TSX UI SDK, renderer, themed components, headless primitives, router, icons, and oxlint preset for zgui-js",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hewel/zgui-js.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/hewel/zgui-js#readme",
  "bugs": {
    "url": "https://github.com/hewel/zgui-js/issues"
  },
  "keywords": [
    "zgui",
    "zgui-js",
    "solid-js",
    "native-ui",
    "desktop",
    "wayland",
    "quickjs",
    "tsx"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "dist",
    "oxlint/recommended.json",
    "oxlint/strict.json",
    "tsconfig.native.json",
    "upstream",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./dnd": {
      "types": "./dist/dnd.d.ts",
      "default": "./dist/dnd.js"
    },
    "./frame-stream": {
      "types": "./dist/frame-stream.d.ts"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "default": "./dist/router/index.js"
    },
    "./icons": {
      "types": "./dist/components/icons.d.ts",
      "default": "./dist/components/icons.js"
    },
    "./shell-host": {
      "types": "./dist/shell-host.d.ts",
      "default": "./dist/shell-host.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./runtime-globals": {
      "types": "./dist/runtime-globals.d.ts",
      "default": "./dist/runtime-globals.js"
    },
    "./oxlint": "./dist/oxlint/plugin.js",
    "./oxlint/recommended": "./oxlint/recommended.json",
    "./oxlint/strict": "./oxlint/strict.json",
    "./tsconfig.native.json": "./tsconfig.native.json",
    "./package.json": "./package.json"
  },
  "imports": {
    "#solid": {
      "types": "./dist/solid-native.d.ts",
      "default": "solid-js"
    }
  },
  "scripts": {
    "build": "bun ../../tools/build-packages.ts ui",
    "prepack": "bun ../../tools/build-packages.ts ui && bun ../../tools/pack-package.ts",
    "postpack": "bun ../../tools/pack-package.ts --clean"
  },
  "dependencies": {
    "@solidjs/signals": "2.0.1",
    "@solidjs/universal": "2.0.1",
    "solid-js": "2.0.1"
  },
  "devDependencies": {
    "oxlint": "1.94.0"
  },
  "peerDependencies": {
    "eslint-plugin-solid": "^0.20.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-solid": {
      "optional": true
    }
  }
}
