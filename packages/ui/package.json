{
  "name": "@hewel/zgui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./renderer": {
      "types": "./src/renderer/index.ts",
      "default": "./src/renderer/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./icons": {
      "types": "./src/components/icons.ts",
      "default": "./src/components/icons.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.ts",
      "default": "./src/jsx-runtime.ts"
    },
    "./runtime-globals": {
      "types": "./src/runtime-globals.ts",
      "default": "./src/runtime-globals.ts"
    },
    "./tsconfig.native.json": "./tsconfig.native.json"
  },
  "imports": {
    "#solid": {
      "types": "./src/solid-native.d.ts",
      "default": "solid-js"
    }
  },
  "dependencies": {
    "solid-js": "1.9.19"
  }
}
