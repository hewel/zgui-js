{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": "./oxlint/src",
    "outDir": "./dist/oxlint",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["oxlint/src/**/*.ts"]
}
