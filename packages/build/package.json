{
  "name": "@hewel/zgui-build",
  "version": "0.1.3",
  "description": "Programmatic compiler, Lightning CSS Modules pipeline, tsrs typechecker, host resolver, and app packager for zgui-js",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hewel/zgui-js.git",
    "directory": "packages/build"
  },
  "homepage": "https://github.com/hewel/zgui-js#readme",
  "bugs": {
    "url": "https://github.com/hewel/zgui-js/issues"
  },
  "keywords": [
    "zgui",
    "zgui-js",
    "build",
    "compiler",
    "rolldown",
    "lightningcss",
    "solid-js",
    "quickjs"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "types": "./src/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./src/public-api.d.ts",
      "default": "./src/index.ts"
    },
    "./internal": {
      "default": "./src/internal.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "sdk",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepack": "bun pack-resources.ts",
    "postpack": "bun pack-resources.ts --clean"
  },
  "dependencies": {
    "@solidjs/compiler": "2.0.1",
    "lightningcss": "1.33.0",
    "rolldown": "1.3.2",
    "solid-js": "2.0.1",
    "tsrs": "7.1.0-beta.tsrs2"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/bun": "1.4.4"
  }
}
