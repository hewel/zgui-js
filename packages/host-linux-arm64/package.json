{
  "name": "@hewel/zgui-host-linux-arm64",
  "version": "0.1.4",
  "description": "Prebuilt zgui-js zgui-host binary for Linux arm64 glibc (reserved, not yet published)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "os": [
    "linux"
  ],
  "cpu": [
    "arm64"
  ],
  "libc": [
    "glibc"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "host-manifest.json",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
